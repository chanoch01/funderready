# Copy to .env and edit. The Makefile loads it automatically.

# Secret key for pseudonymisation, one per organisation, 16+ characters.
# Keep it out of git. Losing it means new loads can no longer be linked to old ones.
FUNDERREADY_PSEUDO_KEY=

# Warehouse (matches docker-compose.yml). Supabase works too: use its connection string.
DESTINATION__POSTGRES__CREDENTIALS=postgresql://funderready:funderready@localhost:5432/funderready
PGHOST=localhost
PGPORT=5432
PGUSER=funderready
PGPASSWORD=funderready
PGDATABASE=funderready
